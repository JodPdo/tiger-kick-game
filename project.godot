; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tiger Kick"
run/main_scene="res://ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameLog="*res://managers/Logger.gd"
ConfigManager="*res://managers/ConfigManager.gd"
NetworkManager="*res://networking/NetworkManager.gd"
ErrorHandler="*res://managers/ErrorHandler.gd"
DebugOverlay="*res://ui/DebugOverlay.gd"

[rendering]

renderer/rendering_method="forward_plus"
