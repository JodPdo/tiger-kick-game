; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are defined by the engine's various subsystems.
;
; It's still a valid text file, which you can shape as you see fit.

config_version=5

[application]

config/name="Tiger Kick"
config/features=PackedStringArray("4.7", "Forward Plus")

; config/run/main_scene is intentionally unset — MainMenu.tscn lands in TK-P0-03

[rendering]

renderer/rendering_method="forward_plus"
